# Copiar a .env y completar. NUNCA subir .env al repositorio (está en .gitignore).

# --- Claves MQTT (una por cliente, mínimo privilegio) ---
CLAVE_GATEWAY=cambiar-clave-gateway
CLAVE_PUENTE=cambiar-clave-puente
CLAVE_SONDA=cambiar-clave-sonda
CLAVE_HMI=cambiar-clave-hmi

# --- Nube AWS Academy (valores entregados por nube-aws/generar_certificado.sh y el log de InfluxDB) ---
AWS_HOST=3.88.0.0
AWS_HUELLA_CERT=AA:BB:CC:...:FF
INFLUX_ORG=planta-agua
INFLUX_BUCKET=telemetria_ot
INFLUX_TOKEN_PUENTE=token-de-solo-escritura

# --- Demo: alterna fallas del dosificador de cloro cada N segundos (0 = desactivado) ---
DEMO_FALLAS_CLORO_CADA=0
